# OPanel Enterprise managed vhost: {{ domain }}
# App type: wordpress
# Generated by OPanel Enterprise — do not edit manually.

docRoot                   {{ root_path }}/{{ document_root }}

vhDomain                  {{ domain }}
{% for alias in aliases %}
vhAliases                 {{ alias }}
{% endfor %}
{% for redirect in redirects %}
vhAliases                 {{ redirect.host }}
{% endfor %}

enableGzip                1
enableBr                  1

index  {
    useServer             0
    indexFiles            index.php, index.html
}

errorlog {{ error_log }} {
    useServer             0
    logLevel              WARN
    rollingSize           10M
}

accesslog {{ access_log }} {
    useServer             0
    rollingSize           100M
    keepDays              30
    logReferer            1
    logUserAgent          1
}

{% if has_ssl %}
vhssl {
    keyFile               {{ ssl_key_path }}
    certFile              {{ ssl_cert_path }}
{% if ssl_ca_path %}
    caBundlePath          {{ ssl_ca_path }}
{% endif %}
    certChain             1
}
{% endif %}

{# One rewrite block only: LiteSpeed does not merge sibling blocks, so the
   HTTPS redirect, the domain redirects and the LSCache markers all live here,
   in that order. They were three separate blocks, which left the later ones
   liable to be dropped. #}
rewrite {
    enable                1
    rewriteRules          <<<END_RULES
{% if ssl_enabled %}RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
{% endif %}{% for redirect in redirects %}RewriteCond %{HTTP_HOST} ^(www\.)?{{ redirect.source }}$ [NC]
RewriteRule ^ {{ redirect.target }}%{REQUEST_URI} [R={{ redirect.code|default(301) }},L]
{% endfor %}RewriteCond %{REQUEST_METHOD} POST
RewriteRule .* - [E=Cache-Control:v=no-cache]
RewriteCond %{QUERY_STRING} !=""
RewriteRule .* - [E=Cache-Control:v=no-cache]
RewriteCond %{HTTP_COOKIE} (comment_author|wordpress_logged_in|wp-postpass) [NC]
RewriteRule .* - [E=Cache-Control:v=no-cache]
END_RULES
}

{% if waf_enabled %}
# OPANEL_ENT WAF BEGIN
module mod_security {
    modsecurity           on
    modsecurity_rules_file  {{ waf_rules_file }}
}
# OPANEL_ENT WAF END
{% endif %}

{% if lsphp_app %}
extprocessor {{ lsphp_app }} {
    type                  lsapi
    address               UDS://{{ lsphp_socket }}
    maxConns              100
    env                   LSAPI_CHILDREN=100
    initTimeout           60
    retryTimeout          0
    persistConn           1
    pcKeepAliveTimeout    60
    respBuffer            0
    autoStart             2
    path                  {{ lsphp_path }}
    extUser               {{ linux_user }}
    extGroup              {{ linux_user }}
    backlog               100
    instances             1
    priority              0
    memSoftLimit          2048M
    procSoftLimit         1000
    procHardLimit         1200
}

scripthandler {
    add                   lsapi:{{ lsphp_app }} php
}
{% endif %}

context /.well-known/acme-challenge/ {
    type                  static
    location              {{ acme_webroot }}/.well-known/acme-challenge/
    allowBrowse           1
    addDefaultCharset     off
}

context / {
    type                  null
    location              {{ root_path }}/{{ document_root }}
    allowOverride         all

{% if lsphp_app %}
    rewrite {
        enable            1
        rewriteRules      <<<END_RULES
RewriteRule ^xmlrpc\.php$ - [F,L]
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
END_RULES
    }
{% endif %}

    addDefaultCharset     off

    phpIniOverride  {
        php_admin_flag    log_errors on
        php_admin_value   error_log {{ php_error_log }}
    }

    rewrite {
        enable              1
        inherit             1
    }
{% if csp_header %}
    extraHeaders <<<END_HEADERS
{% if hsts_header %}{{ hsts_header }}
{% endif %}{{ security_headers }}
Content-Security-Policy: {{ csp_header }}
END_HEADERS
{% endif %}
}

{# Domain redirects are emitted in the single rewrite block near the top. #}

{# LSCache markers are emitted in the single rewrite block near the top. #}
