[Unit]
Description=OPanel API
Documentation=https://github.com/bnixvn/opanel-ent
After=network.target opanel-agent.service
Wants=opanel-agent.service

[Service]
Type=simple
User=opanel
Group=opanel
ExecStart=/usr/local/bin/opanel-api
Restart=always
RestartSec=2
EnvironmentFile=-/etc/opanel/opanel.env

WorkingDirectory=/var/lib/opanel
StateDirectory=opanel
StateDirectoryMode=0750

# The API holds no privilege of its own; everything that touches the host
# goes through the agent socket. Lock it down accordingly.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/var/lib/opanel
# ProtectSystem=strict makes the whole hierarchy read-only, and connect() on a
# unix socket needs write permission on the socket inode -- a read-only bind
# here fails with EACCES. The directory itself stays 0750 root:opanel, so the
# API can reach the socket but still cannot create anything alongside it.
ReadWritePaths=/run/opanel

StandardOutput=journal
StandardError=journal
SyslogIdentifier=opanel-api

[Install]
WantedBy=multi-user.target
