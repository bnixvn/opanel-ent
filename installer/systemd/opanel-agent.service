[Unit]
Description=OPanel privileged agent
Documentation=https://github.com/bnixvn/opanel-ent
After=network.target
Before=opanel-api.service

[Service]
Type=simple
ExecStart=/usr/local/bin/opanel-agent --socket /run/opanel/agent.sock --api-user opanel --socket-group opanel
Restart=always
RestartSec=2

# The agent must be root: that is its purpose. What it does not need is a
# writable filesystem beyond its own runtime directory, or any of the
# capabilities unrelated to managing services, packages and config files.
# User stays root -- the agent needs it. Group=opanel makes systemd create
# the runtime directory as root:opanel so the unprivileged api can traverse
# into it and reach the socket.
Group=opanel
RuntimeDirectory=opanel
RuntimeDirectoryMode=0750
StateDirectory=opanel
StateDirectoryMode=0750

NoNewPrivileges=false
ProtectHome=false
PrivateTmp=false
ProtectSystem=false

# Restarting a wedged agent must not take the panel down for long.
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=opanel-agent

[Install]
WantedBy=multi-user.target
