#!/usr/bin/env bash
# OPanel Enterprise SSH rescue menu.

set -euo pipefail

APP_DIR="${APP_DIR:-/opt/opanel-ent}"
ENV_FILE="${APP_DIR}/backend/.env"
BACKUP_ROOT="${BACKUP_ROOT:-/var/backups/opanel-ent}"
DEFAULT_PANEL_PORT="2222"

if [[ $EUID -ne 0 ]]; then
  echo "Please run as root"
  exit 1
fi

fail() { echo "ERROR: $*" >&2; exit 1; }

ensure_env_file() {
  [[ -f "$ENV_FILE" ]] || fail "$ENV_FILE not found. Run installer first."
}

env_get() {
  local key="$1"
  [[ -f "$ENV_FILE" ]] || return 0
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$ENV_FILE"
}

env_set() {
  local key="$1" value="$2"
  ensure_env_file
  local escaped
  escaped="$(printf '%s' "$value" | sed -e 's/[&|]/\\&/g')"
  if grep -q "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${escaped}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >>"$ENV_FILE"
  fi
}

detect_ip() {
  hostname -I 2>/dev/null | awk '{print $1}' || true
}

find_sshd() {
  if command -v sshd >/dev/null 2>&1; then
    command -v sshd
    return 0
  fi
  for candidate in /usr/sbin/sshd /usr/local/sbin/sshd; do
    [[ -x "$candidate" ]] && { echo "$candidate"; return 0; }
  done
  return 1
}

detect_ssh_ports() {
  local sshd_bin
  sshd_bin="$(find_sshd || true)"
  {
    if [[ -n "$sshd_bin" ]]; then
      "$sshd_bin" -T 2>/dev/null | awk '$1 == "port" {print $2}'
    fi
    if [[ -n "${SSH_CONNECTION:-}" ]]; then
      awk '{print $4}' <<<"$SSH_CONNECTION"
    fi
    awk '
      tolower($1) == "port" && $2 ~ /^[0-9]+$/ { print $2 }
      tolower($1) == "listenaddress" {
        for (i = 2; i <= NF; i++) {
          value = $i
          gsub(/^\[/, "", value)
          gsub(/\]$/, "", value)
          if (value ~ /:[0-9]+$/) {
            sub(/^.*:/, "", value)
            print value
          }
        }
      }
    ' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null
  } | awk '$1 ~ /^[0-9]+$/ && $1 >= 1 && $1 <= 65535 {print $1}' | sort -nu
}

normalize_domain() {
  local value="$1"
  value="${value#http://}"
  value="${value#https://}"
  value="${value%%/*}"
  value="${value%%:*}"
  printf '%s' "$value"
}

validate_domain() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$ ]] \
    || fail "Invalid domain: $1"
}

validate_port() {
  [[ "$1" =~ ^[0-9]{1,5}$ ]] || fail "Invalid port: $1"
  (( "$1" >= 1 && "$1" <= 65535 )) || fail "Port out of range: $1"
}

restart_panel() {
  systemctl daemon-reload || true
  systemctl restart opanel-ent-api
}

login_password_from_file() {
  [[ -f /root/login.txt ]] || return 0
  sed -n 's/^Password: //p' /root/login.txt | head -n 1
}

write_login_info() {
  ensure_env_file
  local password="${1:-}" url tmp
  url="$(env_get PANEL_URL)"
  if [[ -z "$password" ]]; then
    password="$(login_password_from_file)"
  fi
  password="${password:-<not available; run opanel-ent change-admin-password>}"
  (
    if command -v flock >/dev/null 2>&1; then
      flock -x 9
    fi
    tmp="$(mktemp /root/login.txt.XXXXXX)"
    chmod 600 "$tmp"
    cat >"$tmp" <<INFO
Panel URL: ${url}
User: admin
Password: ${password}
INFO
    mv -f "$tmp" /root/login.txt
  ) 9>/root/.opanel-ent-login.lock
  chmod 600 /root/login.txt
}

allow_panel_port() {
  local port="$1"
  validate_port "$port"
  if [[ -x /usr/local/sbin/opanel-ent-helper ]] && id -u opanel-ent >/dev/null 2>&1; then
    sudo -u opanel-ent env HOME="$APP_DIR" sudo -n /usr/local/sbin/opanel-ent-helper iptables-panel-allow-port "$port" >/dev/null 2>&1 || true
  fi
}

allow_panel_app() {
  local app="$1"
  [[ "$app" == "OpenSSH" ]] || return 0
  while read -r ssh_port; do
    [[ -n "$ssh_port" ]] || continue
    allow_panel_port "$ssh_port"
  done <<<"$(detect_ssh_ports)"
}

close_old_panel_port() {
  local old_port="$1" new_port="$2"
  [[ -n "$old_port" && "$old_port" != "$new_port" ]] || return 0
  case "$old_port" in
    22|80|443|465|587) return 0 ;;
  esac
}

refresh_phpmyadmin_api_base() {
  local signon="/usr/share/phpmyadmin/opanel-ent-signon.php"
  [[ -f "$signon" ]] || return 0
  local scheme="$1" port="$2"
  sed -i -E "/api\/databases\/phpmyadmin-sso/s#'[^']+/api/databases/phpmyadmin-sso/'#'${scheme}://127.0.0.1:${port}/api/databases/phpmyadmin-sso/'#" "$signon" || true
}

refresh_tools_nginx() {
  if [[ -x /usr/local/sbin/opanel-ent-helper ]] && id -u opanel-ent >/dev/null 2>&1; then
    sudo -u opanel-ent env HOME="$APP_DIR" sudo -n /usr/local/sbin/opanel-ent-helper refresh-tools >/dev/null 2>&1 || true
  fi
}

run_helper() {
  [[ -x /usr/local/sbin/opanel-ent-helper ]] || fail "opanel-ent-helper is not installed"
  if id -u opanel-ent >/dev/null 2>&1; then
    sudo -u opanel-ent env HOME="$APP_DIR" sudo -n /usr/local/sbin/opanel-ent-helper "$@"
  else
    /usr/local/sbin/opanel-ent-helper "$@"
  fi
}

set_panel_url() {
  ensure_env_file
  local current_port current_domain domain host port scheme url cert key
  current_port="$(env_get PANEL_PORT)"
  current_port="${current_port:-$DEFAULT_PANEL_PORT}"
  current_domain="$(env_get PANEL_DOMAIN)"
  read -rp "Panel domain (blank for server IP): " domain
  read -rp "Panel port [${current_port}]: " port
  port="${port:-$current_port}"
  validate_port "$port"

  if [[ -n "$domain" ]]; then
    domain="$(normalize_domain "$domain")"
    validate_domain "$domain"
    host="$domain"
    env_set PANEL_DOMAIN "$domain"
  else
    host="$(detect_ip)"
    [[ -n "$host" ]] || fail "Cannot detect server IP. Enter a panel domain instead."
    env_set PANEL_DOMAIN ""
  fi

  cert="$(env_get PANEL_SSL_CERT)"
  key="$(env_get PANEL_SSL_KEY)"
  scheme="http"
  if [[ -n "$domain" && "$current_domain" == "$domain" && -n "$cert" && -n "$key" && -f "$cert" && -f "$key" ]]; then
    scheme="https"
  fi
  url="${scheme}://${host}:${port}"

  env_set PANEL_PORT "$port"
  env_set PANEL_URL "$url"
  env_set ALLOWED_ORIGINS "$url"
  if [[ "$scheme" == "http" ]]; then
    env_set PANEL_SSL_CERT ""
    env_set PANEL_SSL_KEY ""
  fi
  allow_panel_port "$port"
  close_old_panel_port "$current_port" "$port"
  write_login_info
  refresh_phpmyadmin_api_base "$scheme" "$port"
  refresh_tools_nginx
  restart_panel
  echo "Panel URL: $url"
}

install_panel_ssl() {
  ensure_env_file
  local domain email port url
  domain="$(env_get PANEL_DOMAIN)"
  if [[ -z "$domain" ]]; then
    read -rp "Panel domain: " domain
    domain="$(normalize_domain "$domain")"
  fi
  validate_domain "$domain"
  email="$(env_get SSL_EMAIL)"
  if [[ -z "$email" ]]; then
    read -rp "Let's Encrypt email: " email
  fi
  [[ "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || fail "Invalid email"

  port="$(env_get PANEL_PORT)"
  port="${port:-$DEFAULT_PANEL_PORT}"
  url="https://${domain}:${port}"

  echo "Issuing certificate for $domain using the shared ACME webroot."
  run_helper panel-ssl-install "$domain" "$port" "$email"
  write_login_info
  refresh_phpmyadmin_api_base "https" "$port"
  refresh_tools_nginx
  echo "Panel SSL enabled: $url"
}

fix_permissions() {
  ensure_env_file
  getent group opanel-ent-sites >/dev/null || groupadd --system opanel-ent-sites
  getent group opanel-ent-sftp >/dev/null || groupadd --system opanel-ent-sftp
  if ! command -v setfacl >/dev/null 2>&1 && command -v apt-get >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y acl
  fi
  usermod -aG opanel-ent-sites opanel-ent 2>/dev/null || true
  usermod -aG opanel-ent-sites www-data 2>/dev/null || true
  if command -v sshd >/dev/null 2>&1; then
    local sshd_config="/etc/ssh/sshd_config"
    local sshd_backup="${sshd_config}.opanel-ent.bak"
    install -d -o root -g root -m 0755 /run/sshd
    rm -f /etc/ssh/sshd_config.d/99-opanel-ent-sftp.conf 2>/dev/null || true
    touch "$sshd_config"
    cp "$sshd_config" "$sshd_backup"
    sed -i '/^# BEGIN OPANEL_ENT SFTP USERS$/,/^# END OPANEL_ENT SFTP USERS$/d' "$sshd_config"
    cat >>"$sshd_config" <<'SSHD'
# BEGIN OPANEL_ENT SFTP USERS
# Allow OPanel Enterprise Linux users to log in with SFTP using their panel password.
Match Group opanel-ent-sftp
    PasswordAuthentication yes
    X11Forwarding no
    AllowTcpForwarding no
# END OPANEL_ENT SFTP USERS
SSHD
    if sshd -t; then
      systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    else
      cp "$sshd_backup" "$sshd_config"
      echo "WARNING: invalid SSHD configuration; skipped OPanel Enterprise SFTP password block"
    fi
  fi
  install -d -o opanel-ent -g opanel-ent -m 0750 "$APP_DIR" "$APP_DIR/backend" "$APP_DIR/frontend"
  install -d -o root -g opanel-ent -m 2775 /etc/nginx/conf.d
  chmod g+s /etc/nginx/conf.d 2>/dev/null || true
  install -d -o opanel-ent -g opanel-ent -m 0750 "$BACKUP_ROOT"
  install -d -o opanel-ent -g opanel-ent -m 0750 /var/lib/opanel-ent
  if [[ -d /etc/opanel-ent ]]; then
    chown root:opanel-ent /etc/opanel-ent /etc/opanel-ent/* 2>/dev/null || true
    chmod 0750 /etc/opanel-ent 2>/dev/null || true
    chmod 0640 /etc/opanel-ent/* 2>/dev/null || true
  fi
  chown -R opanel-ent:opanel-ent "$APP_DIR/backend" "$APP_DIR/frontend" 2>/dev/null || true
  chown opanel-ent:opanel-ent /var/lib/opanel-ent 2>/dev/null || true
  [[ -d /var/lib/opanel-ent/assets ]] && chown -R opanel-ent:opanel-ent /var/lib/opanel-ent/assets 2>/dev/null || true
  chmod 0640 "$ENV_FILE" 2>/dev/null || true
  if [[ -d "$APP_DIR/frontend/dist" ]]; then
    chmod o+rX "$APP_DIR" "$APP_DIR/frontend" 2>/dev/null || true
    chmod -R o+rX "$APP_DIR/frontend/dist"
  fi
  if [[ -x "$APP_DIR/backend/.venv/bin/python" ]]; then
    cd "$APP_DIR/backend"
    runuser -u opanel-ent -- env HOME="$APP_DIR" opanel_ent_USE_HELPER=true "$APP_DIR/backend/.venv/bin/python" - <<'PY'
from app.core.database import SessionLocal
from app.models.entities import Website
from app.services import openlitespeed, site_users, waf

db = SessionLocal()
try:
    websites = db.query(Website).all()
    for website in websites:
        if website.linux_user:
            runtime_php_version = website.php_version if (website.app_type or "wordpress") in {"wordpress", "php"} else None
            site_users.ensure_site_runtime(website.domain, website.root_path, runtime_php_version, website.linux_user)
            site_users.ensure_document_root(
                website.root_path,
                getattr(website, "document_root", "public_html") or "public_html",
                website.linux_user,
            )
        try:
            site_users.fix_site_permissions(website.root_path, website.linux_user)
        except ValueError as exc:
            # A row whose root_path predates the per-site Linux user layout has
            # no owner to derive. Say so and carry on -- one unattributable site
            # must not stop the other 179 from being repaired.
            print(f"  skipped {website.domain}: {exc}")
        app_type = website.app_type or "wordpress"
        runtime_php_version = website.php_version if app_type in {"wordpress", "php"} else None
        result = waf.sync_website_rules(website)
        if result.returncode != 0:
            raise RuntimeError(result.stderr or result.stdout or "Unable to sync WAF rules")
        if getattr(website, "nginx_config_mode", "managed") != "managed":
            website.nginx_config_mode = "managed"
            db.commit()
        openlitespeed.rewrite_vhost(
            website.domain,
            website.root_path,
            app_type=app_type,
            php_version=website.php_version,
            custom_directives=website.nginx_custom or "",
            linux_user=website.linux_user,
            lsphp_socket_override=site_users.site_lsphp_socket(website.linux_user, website.root_path, runtime_php_version),
            waf_enabled=website.waf_enabled,
            document_root=getattr(website, "document_root", "public_html") or "public_html",
            rewrite_mode=getattr(website, "nginx_rewrite_mode", "none") or "none",
            ssl_enabled=bool(getattr(website, "ssl_enabled", False)),
            ssl_cert_path=getattr(website, "ssl_cert_path", None),
            ssl_key_path=getattr(website, "ssl_key_path", None),
            ssl_ca_path=getattr(website, "ssl_ca_path", None),
        )
finally:
    db.close()
PY
  fi
  restart_panel
  refresh_tools_nginx
  echo "Permissions fixed."
}

change_admin_password() {
  ensure_env_file
  local password confirm runner
  read -rsp "New admin password: " password; echo
  read -rsp "Confirm password: " confirm; echo
  [[ "$password" == "$confirm" ]] || fail "Passwords do not match"
  [[ ${#password} -ge 12 ]] || fail "Password must be at least 12 characters"

  cd "$APP_DIR/backend"
  if id -u opanel-ent >/dev/null 2>&1; then
    runner=(runuser -u opanel-ent -- env HOME="$APP_DIR" opanel_ent_USE_HELPER=true "opanel_ent_NEW_ADMIN_PASSWORD=$password" "$APP_DIR/backend/.venv/bin/python")
  else
    runner=(env HOME="$APP_DIR" opanel_ent_USE_HELPER=true "opanel_ent_NEW_ADMIN_PASSWORD=$password" "$APP_DIR/backend/.venv/bin/python")
  fi
  "${runner[@]}" - <<'PY'
import os
from app.core.database import SessionLocal
from app.core.security import hash_password
from app.models.entities import User
from app.services import site_users

password = os.environ["opanel_ent_NEW_ADMIN_PASSWORD"]
db = SessionLocal()
try:
    user = db.query(User).filter(User.username == "admin").first()
    if not user:
        raise SystemExit("admin user not found")
    site_users.set_panel_user_password(user.username, password)
    user.hashed_password = hash_password(password)
    user.token_version = (user.token_version or 0) + 1
    db.commit()
finally:
    db.close()
PY
  write_login_info "$password"
  echo "Admin password changed. Existing sessions were invalidated."
}

root_password_hash() {
  local hash
  hash="$(getent shadow root 2>/dev/null | awk -F: '{print $2; exit}')"
  if [[ -z "$hash" && -r /etc/shadow ]]; then
    hash="$(awk -F: '$1 == "root" {print $2; exit}' /etc/shadow)"
  fi
  printf '%s' "$hash"
}

validate_root_password_hash() {
  local hash="$1"
  [[ -n "$hash" ]] || fail "Cannot read root password hash from /etc/shadow"
  case "$hash" in
    \!*|\**|x) fail "Root account does not have an unlocked password hash" ;;
  esac
  case "$hash" in
    \$y\$*|\$gy\$*|\$7\$*|\$6\$*|\$5\$*|\$2a\$*|\$2b\$*|\$2y\$*) ;;
    *) fail "Unsupported root password hash format: ${hash%%\$*}" ;;
  esac
}

sync_admin_root_password() {
  ensure_env_file
  local root_hash runner login_password
  root_hash="$(root_password_hash)"
  validate_root_password_hash "$root_hash"

  if [[ -x /usr/local/sbin/opanel-ent-helper ]]; then
    if [[ "$(id -un)" == "opanel-ent" ]]; then
      sudo -n /usr/local/sbin/opanel-ent-helper panel-user-ensure admin
    elif id -u opanel-ent >/dev/null 2>&1; then
      runuser -u opanel-ent -- sudo -n /usr/local/sbin/opanel-ent-helper panel-user-ensure admin
    else
      /usr/local/sbin/opanel-ent-helper panel-user-ensure admin
    fi
  fi
  id -u admin >/dev/null 2>&1 || fail "Linux user admin not found"
  usermod -p "$root_hash" admin
  passwd -u admin >/dev/null 2>&1 || true

  cd "$APP_DIR/backend"
  if id -u opanel-ent >/dev/null 2>&1; then
    runner=(runuser -u opanel-ent -- env HOME="$APP_DIR" opanel_ent_USE_HELPER=true "opanel_ent_ROOT_PASSWORD_HASH=$root_hash" "$APP_DIR/backend/.venv/bin/python")
  else
    runner=(env HOME="$APP_DIR" opanel_ent_USE_HELPER=true "opanel_ent_ROOT_PASSWORD_HASH=$root_hash" "$APP_DIR/backend/.venv/bin/python")
  fi
  "${runner[@]}" - <<'PY'
import os
from app.core.database import SessionLocal
from app.models.entities import User

root_hash = os.environ["opanel_ent_ROOT_PASSWORD_HASH"]
db = SessionLocal()
try:
    user = db.query(User).filter(User.username == "admin").first()
    if not user:
        raise SystemExit("admin user not found")
    user.hashed_password = root_hash
    user.token_version = (user.token_version or 0) + 1
    db.commit()
finally:
    db.close()
PY
  read -rsp "Root password to write to /root/login.txt (blank to skip): " login_password; echo
  if [[ -n "$login_password" ]]; then
    write_login_info "$login_password"
  fi
  restart_panel
  echo "Admin password now matches the root password. Existing sessions were invalidated."
}

show_status() {
  ensure_env_file
  local port cert key scheme health_url health http_code curl_rc curl_error curl_stderr
  port="$(env_get PANEL_PORT)"; port="${port:-$DEFAULT_PANEL_PORT}"
  cert="$(env_get PANEL_SSL_CERT)"; key="$(env_get PANEL_SSL_KEY)"
  scheme="http"
  if [[ "$(env_get PANEL_URL)" == https://* && -n "$cert" && -n "$key" && -f "$cert" && -f "$key" ]]; then
    scheme="https"
  fi
  health_url="${scheme}://127.0.0.1:${port}/api/health"
  if ! command -v curl >/dev/null 2>&1; then
    health="unknown (curl not found)"
  else
    curl_stderr="$(mktemp)"
    curl_rc=0
    http_code="$(curl -ksS --connect-timeout 2 --max-time 5 -o /dev/null -w '%{http_code}' "$health_url" 2>"$curl_stderr")" || curl_rc=$?
    curl_error="$(tr '\n' ' ' <"$curl_stderr" | sed -e 's/[[:space:]]*$//')"
    rm -f "$curl_stderr"
    if [[ "$curl_rc" -eq 0 && "$http_code" == "200" ]]; then
      health="ok (HTTP 200)"
    else
      health="failed (curl=${curl_rc}, http=${http_code:-000}${curl_error:+, ${curl_error}})"
    fi
  fi
  echo "Panel URL: $(env_get PANEL_URL)"
  echo "Local health: ${health} (${health_url})"
  echo "API: $(systemctl is-active opanel-ent-api 2>/dev/null || echo unknown)"
  echo "OpenLiteSpeed: $(systemctl is-active lsws 2>/dev/null || echo unknown)"
  echo "MariaDB: $(systemctl is-active mariadb 2>/dev/null || echo unknown)"
  echo "Redis: $(systemctl is-active redis-server 2>/dev/null || echo unknown)"
  if [[ -x /usr/local/sbin/opanel-ent-helper ]] && id -u opanel-ent >/dev/null 2>&1; then
    echo "Firewall: $(sudo -u opanel-ent env HOME="$APP_DIR" sudo -n /usr/local/sbin/opanel-ent-helper iptables-check-enabled 2>/dev/null || echo unknown)"
  fi
}

show_login_info() {
  ensure_env_file
  local panel_url password
  panel_url="$(env_get PANEL_URL)"
  # Read password from /root/login.txt if available
  if [[ -f /root/login.txt ]]; then
    password="$(sed -n 's/^Password: //p' /root/login.txt)"
  fi
  echo "Panel URL: ${panel_url:-<not set>}"
  echo "User: admin"
  echo "Password: ${password:-<not available; run opanel-ent change-admin-password>}"
  # Refresh /root/login.txt so it stays current
  if [[ -n "$panel_url" ]]; then
    cat > /root/login.txt <<EOF
Panel URL: ${panel_url}
User: admin
Password: ${password:-<not available>}
EOF
  fi
}

restart_panel_command() {
  systemctl daemon-reload || true
  for service in mariadb redis-server lsws opanel-ent-api; do
    if systemctl restart "$service" 2>/dev/null; then
      echo "${service}: restarted"
    else
      echo "${service}: failed"
    fi
  done
}

show_logs() {
  echo "== opanel-ent-api =="
  journalctl -u opanel-ent-api -n 120 --no-pager 2>/dev/null || true
  echo ""
  echo "== OpenLiteSpeed error.log =="
  tail -n 80 /usr/local/lsws/logs/error.log 2>/dev/null || echo "No OpenLiteSpeed error log found."
  if [[ -f /var/log/opanel-ent-panel-update.log ]]; then
    echo ""
    echo "== opanel-ent update =="
    tail -n 80 /var/log/opanel-ent-panel-update.log
  fi
}

repair_firewall() {
  ensure_env_file
  local panel_port ssh_port port seen_ssh_ports
  panel_port="$(env_get PANEL_PORT)"; panel_port="${panel_port:-$DEFAULT_PANEL_PORT}"
  validate_port "$panel_port"
  allow_panel_app OpenSSH
  seen_ssh_ports="$(detect_ssh_ports)"
  while read -r ssh_port; do
    [[ -n "$ssh_port" ]] || continue
    [[ "$ssh_port" == "22" ]] && continue
    allow_panel_port "$ssh_port"
  done <<<"$seen_ssh_ports"
  allow_panel_port 80
  allow_panel_port 443
  for port in 465 587 "$panel_port"; do
    case "$port" in
      80|443) continue ;;
    esac
    allow_panel_port "$port"
  done
  if [[ -x /usr/local/sbin/opanel-ent-helper ]] && id -u opanel-ent >/dev/null 2>&1; then
    sudo -u opanel-ent env HOME="$APP_DIR" sudo -n /usr/local/sbin/opanel-ent-helper iptables-status || true
  fi
  echo "Firewall rescue rules refreshed."
}

run_panel_update() {
  [[ -x /usr/local/sbin/opanel-ent-update ]] || fail "/usr/local/sbin/opanel-ent-update not found"
  read -rp "Update opanel-ent to the latest version now? [y/N]: " confirm
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) echo "Canceled."; return 0 ;;
  esac
  /usr/local/sbin/opanel-ent-update
}

change_panel_ip() {
  local script="/usr/local/sbin/opanel-ent-change-ip" old_ip new_ip current_ip
  [[ -x "$script" ]] || fail "$script not found. Reinstall/update opanel-ent or copy change_IP.sh to that path."

  current_ip="$(detect_ip)"
  read -rp "Old IP: " old_ip
  if [[ -n "$current_ip" ]]; then
    read -rp "New IP [${current_ip}]: " new_ip
    new_ip="${new_ip:-$current_ip}"
  else
    read -rp "New IP: " new_ip
  fi
  "$script" "$old_ip" "$new_ip"
}

menu() {
  while true; do
    echo ""
    echo "OPanel Enterprise SSH Rescue Menu"
    echo "1) Show login info"
    echo "2) Show rescue status"
    echo "3) View recent logs"
    echo "4) Restart panel services"
    echo "5) Repair firewall ports"
    echo "6) Set/reset panel URL / port"
    echo "7) Install/repair panel SSL"
    echo "8) Fix permissions/runtime"
    echo "9) Change admin password"
    echo "10) Update panel from release"
    echo "11) Change server IP"
    echo "12) Sync admin password from root"
    echo "0) Exit"
    read -rp "Choose: " choice
    case "$choice" in
      1) show_login_info ;;
      2) show_status ;;
      3) show_logs ;;
      4) restart_panel_command ;;
      5) repair_firewall ;;
      6) set_panel_url ;;
      7) install_panel_ssl ;;
      8) fix_permissions ;;
      9) change_admin_password ;;
      10) run_panel_update ;;
      11) change_panel_ip ;;
      12) sync_admin_root_password ;;
      0) exit 0 ;;
      *) echo "Invalid choice" ;;
    esac
  done
}

case "${1:-menu}" in
  menu|--menu) menu ;;
  login|--login|show-login|--show-login) show_login_info ;;
  logs|--logs) show_logs ;;
  restart|--restart) restart_panel_command ;;
  repair-firewall|--repair-firewall) repair_firewall ;;
  update|--update) run_panel_update ;;
  change-ip|--change-ip) change_panel_ip ;;
  set-panel-url|--set-panel-url) set_panel_url ;;
  install-panel-ssl|--install-panel-ssl) install_panel_ssl ;;
  fix-permissions|--fix-permissions) fix_permissions ;;
  change-admin-password|--change-admin-password) change_admin_password ;;
  sync-admin-root-password|--sync-admin-root-password|admin-use-root-password|--admin-use-root-password) sync_admin_root_password ;;
  status|--status) show_status ;;
  *)
    echo "Usage: opanel-ent [menu|login|status|logs|restart|repair-firewall|change-ip|set-panel-url|install-panel-ssl|fix-permissions|change-admin-password|sync-admin-root-password|update]"
    exit 2
    ;;
esac
