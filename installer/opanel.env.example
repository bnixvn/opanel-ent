# OPanel API configuration. Copy to /etc/opanel/opanel.env.
# Every value below is the built-in default; uncomment to change one.

#OPANEL_ENV=prod
#OPANEL_LISTEN=127.0.0.1:2222
#OPANEL_DATA_DIR=/var/lib/opanel
#OPANEL_DB_PATH=/var/lib/opanel/opanel.db
#OPANEL_AGENT_SOCKET=/run/opanel/agent.sock
#OPANEL_PANEL_HOST=
#OPANEL_SESSION_TTL=12h
#OPANEL_SESSION_IDLE_TTL=2h
#OPANEL_WEBSERVER_BACKEND=ols
#OPANEL_PHP_PROVIDER=
#OPANEL_LOG_LEVEL=info
