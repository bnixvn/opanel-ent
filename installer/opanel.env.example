# OPanel API configuration. Copy to /etc/opanel/opanel.env.
# Every value below is the built-in default; uncomment to change one.

#OPANEL_ENV=prod
#OPANEL_LISTEN=0.0.0.0:2222
#OPANEL_DATA_DIR=/var/lib/opanel
#OPANEL_DB_PATH=/var/lib/opanel/opanel.db
#OPANEL_AGENT_SOCKET=/run/opanel/agent.sock
#OPANEL_PANEL_HOST=

# TLS is on by default. With no certificate supplied the panel generates a
# self-signed one under OPANEL_TLS_DIR; point the two paths below at a real
# certificate once the panel has a resolvable hostname.
#OPANEL_TLS=true
#OPANEL_TLS_DIR=/var/lib/opanel/tls
#OPANEL_TLS_CERT=
#OPANEL_TLS_KEY=

#OPANEL_SESSION_TTL=12h
#OPANEL_SESSION_IDLE_TTL=2h
#OPANEL_WEBSERVER_BACKEND=ols
#OPANEL_PHP_PROVIDER=
#OPANEL_LOG_LEVEL=info
