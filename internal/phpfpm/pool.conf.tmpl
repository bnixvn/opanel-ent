; Generated by OPanel. Do not edit: this file is rewritten from the panel
; database on every change and edits made here will be lost.
;
; Pool: {{ .Name }}  (PHP {{ .Version }}, running as {{ .User }})

[{{ .Name }}]
user = {{ .User }}
group = {{ .Group }}

listen = {{ .Socket }}
; The webserver opens the socket, so the socket belongs to the webserver's
; account. The pool itself runs as the site owner -- that is the direction
; that matters, and reversing it would let one site's code read another's.
listen.owner = {{ .SocketOwner }}
listen.group = {{ .SocketOwner }}
listen.mode = 0660

; ondemand, not dynamic: a shared host has many sites and few of them are
; busy at once. Idle sites cost one master process between them instead of a
; handful of children each, and the first request after an idle period pays
; a few milliseconds to start one.
pm = ondemand
pm.max_children = {{ .MaxChildren }}
pm.process_idle_timeout = 10s
pm.max_requests = 500

; A request that has run for five minutes is not going to finish. The log
; line names the script, which is the only useful thing to know about it.
request_terminate_timeout = 300s
request_slowlog_timeout = 60s
slowlog = {{ .LogDir }}/php-slow.log

catch_workers_output = yes
php_admin_value[error_log] = {{ .LogDir }}/php-error.log
php_admin_flag[log_errors] = on

; open_basedir keeps a site's PHP inside its own tree and the two shared
; directories it legitimately needs. It is the backstop for the case where
; the account boundary alone is not enough, such as a world-readable file
; somewhere else on the host.
php_admin_value[open_basedir] = {{ .Basedir }}:/tmp:/usr/share/php:/var/lib/php
php_admin_value[upload_tmp_dir] = /tmp
php_admin_value[session.save_path] = /tmp
{{- if .Keys }}

; php.ini overrides for this site. php_admin_value rather than php_value: the
; application must not be able to raise with ini_set() a limit the host set.
{{- range .Keys }}
php_admin_value[{{ . }}] = {{ index $.Settings . }}
{{- end }}
{{- end }}
