#
# {{ .Config.PanelManagedComment }}
#
# Site: {{ .Site.Domain }}  ({{ .Site.AppType }}{{ if .Site.NeedsPHP }}, PHP {{ .Site.PHPVersion }}{{ end }}){{ if .Site.Suspended }}  [SUSPENDED]{{ end }}
# Owner: {{ .Site.OwnerUser }}
#

{{ if .ServeWAF -}}
# The web application firewall, switched on for this site. The rule set and
# the mode are server-wide; this only opts in.
module mod_security {
    modsecurity              on
}

{{ end -}}
docRoot                       {{ .EffectiveDocRoot }}
enableGzip                    1
enableBr                      1

errorlog {{ .Site.LogDir }}/error.log {
    useServer                 0
    logLevel                  ERROR
    rollingSize               10M
    keepDays                  30
}

accesslog {{ .Site.LogDir }}/access.log {
    useServer                 0
    rollingSize               10M
    keepDays                  30
    compressArchive           1
}

index {
    useServer                 0
    indexFiles                {{ if .Site.NeedsPHP }}index.php, {{ end }}index.html, index.htm
    autoIndex                 0
}

expires {
    enableExpires             1
}
{{ if .Site.SSLEnabled }}
vhssl {
    keyFile                   {{ .Site.KeyFile }}
    certFile                  {{ .Site.CertFile }}
    certChain                 1
    sslProtocol               24
    enableECDHE               1
    enableSpdy                15
    enableQuic                1
}
{{ end }}
{{- if .ServePHP }}
# One external application per site, running as the site's own Linux account.
# This is what keeps one customer's PHP out of another customer's files; a
# single shared interpreter would run every site as the same user.
extprocessor {{ .AppName }} {
    type                      lsapi
    address                   uds://tmp/lshttpd/{{ .AppName }}.sock
    maxConns                  {{ .MaxConns }}
    env                       PHP_LSAPI_CHILDREN={{ .MaxConns }}
    env                       LSAPI_AVOID_FORK=200M
    env                       PHP_LSAPI_MAX_REQUESTS=5000
    initTimeout               60
    retryTimeout              0
    persistConn               1
    pcKeepAliveTimeout        60
    respBuffer                0
    autoStart                 2
    path                      {{ .Site.LSAPIBinary }}
    extUser                   {{ .Site.OwnerUser }}
    extGroup                  {{ .Site.OwnerGroup }}
    backlog                   100
    instances                 1
    priority                  0
    memSoftLimit              {{ .MemSoftLimit }}
    memHardLimit              {{ .MemHardLimit }}
    procSoftLimit             {{ .ProcSoftLimit }}
    procHardLimit             {{ .ProcHardLimit }}
}

scripthandler {
    add                       lsapi:{{ .AppName }} php
}
{{- end }}

{{ if .Site.Suspended -}}
# Suspended: the document root is swapped for the shared notice page and no
# interpreter is configured, so nothing of the customer's application runs.
# The vhost itself stays in place, making unsuspend a single re-render.
context / {
    location                  {{ .EffectiveDocRoot }}
    allowBrowse               1
    indexFiles                index.html
}
{{- else -}}
context / {
    location                  {{ .Site.DocumentRoot }}
    allowBrowse               1
    # .htaccess is how WordPress and most PHP applications express their own
    # rewrite rules, so it is honoured rather than replaced.
    rewrite {
        enable                1
        allowOverride         1
    }
    addDefaultCharset         off
}
{{- end }}
{{ if and .Site.ForceHTTPS .Site.SSLEnabled }}
# Plain HTTP is redirected, except the challenge path below: a renewal that
# 301s to HTTPS cannot be validated when the certificate it is renewing has
# already expired.
rewrite {
    enable                    1
    RewriteCond %{HTTPS} !on
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]
}
{{ end }}
# Certificate renewals must keep working while the site is live, and while it
# is suspended: a suspension is not a reason to let the certificate lapse.
context /.well-known/acme-challenge {
    location                  {{ .ACMEWebroot }}/.well-known/acme-challenge
    allowBrowse               1
}
{{- if and .RewriteRules (not .Site.Suspended) }}
rewrite {
    enable                    1
    autoLoadHtaccess          1
{{ .RewriteRules }}
}
{{- end }}
{{- if .ServePHP }}

# Deny direct access to files that should never be served, whatever the
# application's own rules say.
context /.git {
    location                  {{ .Site.DocumentRoot }}/.git
    allowBrowse               0
}

context /vendor {
    location                  {{ .Site.DocumentRoot }}/vendor
    allowBrowse               0
}
{{- end }}
{{- if and .ServePHP (eq .Site.AppType "wordpress") }}

# xmlrpc.php is a standing brute-force and pingback-amplification target and
# is not needed by a normal WordPress site.
context /xmlrpc.php {
    location                  {{ .Site.DocumentRoot }}/xmlrpc.php
    allowBrowse               0
}
{{- end }}
