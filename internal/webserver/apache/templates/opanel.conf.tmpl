#
# {{ .Config.PanelManagedComment }}
#
# One file in conf.d, one directory of vhosts. Anything else under
# /etc/httpd belongs to the distribution or to you, and the panel does not
# touch it.
#

ServerTokens Prod
ServerSignature Off
TraceEnable Off
{{- if .Config.AdminEmail }}
ServerAdmin {{ .Config.AdminEmail }}
{{- end }}
{{- range .ExtraListen }}
Listen {{ . }}
{{- end }}

# Proxied PHP is a long-running conversation over a unix socket, not a fetch
# from another host: five seconds to accept, five minutes to finish. The
# default of a few seconds turns a slow import into a 503 halfway through.
<IfModule proxy_module>
    ProxyTimeout 300
</IfModule>

<Directory "{{ .ACMEWebroot }}">
    Options None
    AllowOverride None
    Require all granted
</Directory>

<Directory "{{ .Suspended }}">
    Options None
    AllowOverride None
    Require all granted
</Directory>

# Nothing outside a site's own tree is servable. A misrendered DocumentRoot
# then serves nothing rather than the filesystem.
<Directory />
    AllowOverride None
    Require all denied
</Directory>
{{- if .Config.WAFRulesFile }}

<IfModule security2_module>
    IncludeOptional {{ .Config.WAFRulesFile }}
</IfModule>
{{- end }}
{{- if and .Config.PMARoot .Config.PMAPort }}

# phpMyAdmin, bound to the loopback address. The panel proxies to it after
# checking the session, so it needs no hostname, no certificate and no second
# password, and nothing outside this machine can reach it.
<VirtualHost 127.0.0.1:{{ .Config.PMAPort }}>
    DocumentRoot "{{ .Config.PMARoot }}"

    <Directory "{{ .Config.PMARoot }}">
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        DirectoryIndex index.php
    </Directory>
{{- if .Config.PMAFPMSocket }}

    <FilesMatch "\.php$">
        SetHandler "proxy:unix:{{ .Config.PMAFPMSocket }}|fcgi://localhost"
    </FilesMatch>
{{- end }}
</VirtualHost>
{{- end }}

# Load order decides which vhost answers for a hostname nothing claims, and
# this file sorts before the distribution's ssl.conf and welcome.conf. The
# default vhost inside is named to sort first here for the same reason.
IncludeOptional {{ .VhostsDir }}/*.conf
