#
# {{ .Config.PanelManagedComment }}
#
# Site: {{ .Site.Domain }}  ({{ .Site.AppType }}{{ if .Site.NeedsPHP }}, PHP {{ .Site.PHPVersion }}{{ end }}){{ if .Site.Suspended }}  [SUSPENDED]{{ end }}
# Owner: {{ .Site.OwnerUser }}
#

<VirtualHost *:{{ .Config.HTTPPort }}>
{{- template "names" . }}
{{- if and .Site.ForceHTTPS .Site.SSLEnabled }}

    # Plain HTTP is redirected, except the challenge path: a renewal that
    # 301s to HTTPS cannot be validated when the certificate it is renewing
    # has already expired. This sits above the site's own rules because a
    # vhost-level rewrite runs before a per-directory one.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]
{{- end }}
{{- template "body" . }}
</VirtualHost>
{{- if .Site.SSLEnabled }}

<IfModule ssl_module>
<VirtualHost *:{{ .Config.HTTPSPort }}>
{{- template "names" . }}

    SSLEngine on
    SSLCertificateFile {{ .Site.CertFile }}
    SSLCertificateKeyFile {{ .Site.KeyFile }}
    # TLS 1.2 and 1.3 only. Everything older is either broken or only
    # reachable by clients that no site here needs to serve.
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off
{{- template "body" . }}
</VirtualHost>
</IfModule>
{{- end }}

{{- define "names" }}
    ServerName {{ .Site.Domain }}
{{- range .Site.Aliases }}
    ServerAlias {{ . }}
{{- end }}
{{- end }}

{{- define "body" }}

    ErrorLog "{{ .Site.LogDir }}/error.log"
    CustomLog "{{ .Site.LogDir }}/access.log" combined

    # Every hostname on this server answers challenges from one directory,
    # rather than each site answering from its own document root. A site that
    # rewrites every request to a front controller would otherwise stop its
    # own certificate renewing. Suspended sites keep this too: a suspension
    # is not a reason to let a certificate lapse.
    Alias /.well-known/acme-challenge/ "{{ .ACMEWebroot }}/.well-known/acme-challenge/"
{{- if .Site.Suspended }}

    # Suspended: the document root is the shared notice and no interpreter is
    # configured, so nothing of the customer's application runs. The vhost
    # stays in place, which makes unsuspending a single re-render.
    DocumentRoot "{{ .Suspended }}"

    <Directory "{{ .Suspended }}">
        Options None
        AllowOverride None
        Require all granted
        DirectoryIndex index.html
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ /index.html [L]
{{- else }}
    DocumentRoot "{{ .Site.DocumentRoot }}"

    <Directory "{{ .Site.DocumentRoot }}">
        Options -Indexes +FollowSymLinks
        # .htaccess is how WordPress and most PHP applications express their
        # own rewrite rules, so it is honoured rather than replaced.
        AllowOverride All
        Require all granted
        DirectoryIndex {{ if .Site.NeedsPHP }}index.php {{ end }}index.html index.htm
{{- if .Rewrite }}

{{ .Rewrite }}
{{- end }}
    </Directory>

    # Deny what should never be served, whatever the application's own rules
    # say. A dotfile match rather than a list: .env, .git/config and
    # .htpasswd are the ones people lose data to, and the next one has not
    # been named yet.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    <DirectoryMatch "{{ .Site.DocumentRoot }}/(\.git|\.svn|vendor|node_modules)">
        Require all denied
    </DirectoryMatch>
{{- if .Site.FPMSocket }}

    # PHP runs in a pool of its own, owned by this site's Linux account. That
    # is what keeps one customer's code out of another customer's files: a
    # shared interpreter would run every site as the same user.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:{{ .Site.FPMSocket }}|fcgi://localhost"
    </FilesMatch>

{{- if eq .Site.AppType "wordpress" }}

    # xmlrpc.php is a standing brute-force and pingback-amplification target
    # and is not needed by a normal WordPress site.
    <Files "xmlrpc.php">
        Require all denied
    </Files>
{{- end }}
{{- end }}
{{- end }}

{{- if and .Site.WAFEnabled (not .Site.Suspended) }}

    # The firewall, switched on for this site. The rule set and the mode are
    # server-wide; this only opts in.
    <IfModule security2_module>
        SecRuleEngine On
    </IfModule>
{{- else }}

    <IfModule security2_module>
        SecRuleEngine Off
    </IfModule>
{{- end }}

    <IfModule deflate_module>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
        AddOutputFilterByType DEFLATE text/javascript application/javascript
        AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
    </IfModule>

    <IfModule brotli_module>
        AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
        AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
        AddOutputFilterByType BROTLI_COMPRESS application/json application/xml image/svg+xml
    </IfModule>
{{- end }}
